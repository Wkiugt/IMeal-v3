{
  "name": "@imeal/core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "yarn prisma:generate && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --config ./vitest.unit.config.ts",
    "test:db": "vitest run --exclude \"**/*.unit.test.ts\"",
    "seed:local": "node --import tsx src/local-seed/cli.ts",
    "prisma": "prisma",
    "prisma:generate": "node scripts/generate-prisma.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/pg": "^8.23.1",
    "dotenv": "^17.4.2",
    "prisma": "7.10.0",
    "tsx": "^4.20.3",
    "typescript": "^5.6.2",
    "vitest": "^4.1.11"
  }
}
