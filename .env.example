# Disposable local Docker values only. Replace each CHANGE_ME_LOCAL value with
# a unique local value before starting the stack; never reuse these values in
# staging/production and never add real credentials to this tracked template.
# Production deployments must supply all secrets/provider settings out of band.
# PostgreSQL Settings
POSTGRES_USER=CHANGE_ME_LOCAL
POSTGRES_PASSWORD=CHANGE_ME_LOCAL
POSTGRES_DB=imeal
POSTGRES_PORT=5432

# PgBouncer Settings
PGBOUNCER_PORT=6432

# MinIO Settings
MINIO_ROOT_USER=CHANGE_ME_LOCAL
MINIO_ROOT_PASSWORD=CHANGE_ME_LOCAL
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=imeal-bucket

# Reverse Proxy (Caddy) Settings
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443
# Empty outside production: the API then trusts nobody and ignores forwarding headers.
# Production and staging Compose set this to the internal app-network CIDR that
# connects Caddy to the API. See docs/runbooks/trusted-proxy.md.
# TRUSTED_PROXY_CIDRS=

# API authentication and email OTP delivery.
# Production is OTP-only; REQUIRE_AUTH=false is a test-harness flag and is
# rejected unless NODE_ENV=test. Replace every placeholder secret out of band.
NODE_ENV=development
AUTH_MODE=otp
REQUIRE_AUTH=true
DATABASE_URL=postgresql://CHANGE_ME_LOCAL:CHANGE_ME_LOCAL@localhost:6432/imeal?schema=public&pgbouncer=true
QR_SIGNING_SECRET=replace-with-at-least-32-random-characters
OTP_HASH_SECRET=replace-with-at-least-32-random-characters
OTP_DELIVERY_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
# Gmail SMTP for worker OTP delivery. OTP_SMTP_PASSWORD is a Google App Password,
# never the normal Google account password. Never commit real credentials.
# The production worker needs outbound TCP to smtp.gmail.com:587. Host and port
# are safe defaults; production Compose hard-defaults them.
OTP_SMTP_HOST=smtp.gmail.com
OTP_SMTP_PORT=587
OTP_SMTP_USERNAME=
OTP_SMTP_PASSWORD=
OTP_SMTP_FROM=
OTP_SMTP_FROM_NAME=IMeal
OTP_SMTP_REQUIRE_TLS=true
OTP_EXPIRY_SECONDS=600
OTP_RESEND_SECONDS=60
OTP_ATTEMPT_LIMIT=5
OTP_RATE_WINDOW_SECONDS=3600
OTP_ADDRESS_RATE_LIMIT=5
OTP_CLIENT_RATE_LIMIT=20

# Runtime lifecycle and migration evidence. Production values are injected out of band.
# SHUTDOWN_TIMEOUT_SECONDS bounds graceful drain time to 1-300 seconds.
RELEASE_VERSION=local
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_SECONDS=30
MIGRATION_EVIDENCE_PATH=/run/imeal/migration-gate.json
MIGRATION_TARGET_IDENTITY=local
# MIGRATION_DATABASE_URL=postgresql://CHANGE_ME_LOCAL:CHANGE_ME_LOCAL@postgres/imeal
# MIGRATION_DATABASE_URL is migration-gate-only; never pass it to API or worker.
# Production Compose boundary (inject these values from the deployment secret
# store; this template intentionally contains no production defaults).
# MIGRATION_TARGET_SCHEMA=
# MIGRATION_TARGET_SCHEMA is shared by the migration gate and API/worker
# PgBouncer DATABASE_URL values; target-only gate search_path has no public fallback.
# Opaque worker authoritative metrics source references. Production Compose
# requires each binding; inject reference names out of band, never credentials,
# URLs, targets, or source payloads.
# WORKER_METRICS_POSTGRES_SOURCE=
# WORKER_METRICS_OBJECT_STORAGE_SOURCE=
# WORKER_METRICS_BACKUP_EVIDENCE_SOURCE=
# WORKER_METRICS_SECURITY_BOUNDARY_SOURCE=
# Protected source registry/feed URL; production Compose requires this value.
# Keep the URL out of source references and inject it from the deployment store.
# WORKER_METRICS_SOURCE_REGISTRY_URL=
# Optional bearer access for deployments approved to use bearer authentication;
# leave unset when workload identity or mTLS is supplied by the platform.
# WORKER_METRICS_SOURCE_BEARER_TOKEN=
# Target-bound SHA-256 fingerprint only; inject from protected evidence, never credentials.
#
# WORKER_METRICS_TARGET_FINGERPRINT=
# Private structured API-to-worker transport and caller evidence; inject URL,
# tokens, and digests from the protected deployment store. Never commit values
# or log tokens.
#
# WORKER_METRICS_TRANSPORT_URL=
# WORKER_METRICS_TRANSPORT_TOKEN=
# WORKER_METRICS_EVIDENCE_DIGEST=
# API_METRICS_EVIDENCE_DIGEST=
#
# PUBLIC_HOSTNAME=
# ACME_EMAIL=
# MIGRATION_APPROVAL_ID=
# MIGRATION_GATE_IMAGE=
# API_IMAGE=
# WORKER_IMAGE=
# ADMIN_WEB_IMAGE=
# MINIO_IMAGE=
# MINIO_MC_IMAGE=
# STOP_GRACE_PERIOD=45s  # must be at least SHUTDOWN_TIMEOUT_SECONDS + 5s
#
# The production overlay is prebuilt-only: CI builds the Dockerfiles, publishes
# digest-pinned images, and deployment Compose only pulls/runs those images.
# Local synthetic boundary check:
#   yarn verify:production-boundary
# Validate actual deployment values (without starting services):
#   yarn verify:production-boundary --env-file path/to/production.env
# PGBOUNCER_MAX_CLIENT_CONN=
# PGBOUNCER_DEFAULT_POOL_SIZE=
# DB_VOLUME_NAME=
# MINIO_VOLUME_NAME=
# MIGRATION_EVIDENCE_VOLUME_NAME=
# CADDY_DATA_VOLUME_NAME=
# CADDY_CONFIG_VOLUME_NAME=
# EDGE_NETWORK_NAME=
# APP_NETWORK_NAME=
# DATA_NETWORK_NAME=
# EGRESS_NETWORK_NAME=

# Each *_IMAGE value above must be an immutable repository@sha256:digest ref.



# Opaque PostgreSQL-backed session policy
SESSION_HASH_SECRET=replace-with-at-least-32-random-characters
SESSION_IDLE_TIMEOUT_SECONDS=1800
SESSION_ABSOLUTE_TIMEOUT_SECONDS=604800

# OTP delivery worker policy (the worker validates all values in production)
OTP_DELIVERY_BATCH_SIZE=100
OTP_DELIVERY_MAX_ATTEMPTS=4
OTP_DELIVERY_RETRY_BASE_SECONDS=60
OTP_DELIVERY_RETRY_MAX_SECONDS=900
OTP_DELIVERY_CLAIM_TIMEOUT_SECONDS=300

# Staff GPS policy defaults for self check-in resolve and confirm.
# Real location coordinates are imported by authorized operations, never seeded here.
GPS_DEFAULT_GEOFENCE_RADIUS_METERS=150
GPS_DEFAULT_MAX_FIX_AGE_SECONDS=30
GPS_DEFAULT_MAX_ACCURACY_METERS=100

# Check-in window invariants. Shared Kitchen QR stays stable for this meal date/location.
SERVING_TIME_ZONE=Asia/Ho_Chi_Minh
SERVING_WINDOW_START=10:30
SERVING_WINDOW_END=13:30
NO_SHOW_PROCESSING_TIME=13:45

# Mobile and Admin Web API configuration
# EXPO_PUBLIC_API_URL is an explicit public API origin ending in /api, such as https://<api-id>.ngrok-free.app/api. Leave it empty for local/LAN discovery.
# EXPO_PACKAGER_PROXY_URL is a public origin that proxies Metro port 8081, without an /api suffix. Set both values only for remote-device sessions.
EXPO_PUBLIC_API_URL=
EXPO_PACKAGER_PROXY_URL=
VITE_API_URL=http://localhost:3000
EXPO_PUBLIC_EAS_PROJECT_ID=
