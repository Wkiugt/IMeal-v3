# Disposable local Docker values only. Replace each CHANGE_ME_LOCAL value with
# a unique local value before starting the stack; never reuse these values in
# staging/production and never add real credentials to this tracked template.
# Production deployments must supply all secrets/provider settings out of band.
# PostgreSQL Settings
POSTGRES_USER=CHANGE_ME_LOCAL
POSTGRES_PASSWORD=CHANGE_ME_LOCAL
POSTGRES_DB=imeal
POSTGRES_PORT=5432

# PgBouncer Settings
PGBOUNCER_PORT=6432

# MinIO Settings
MINIO_ROOT_USER=CHANGE_ME_LOCAL
MINIO_ROOT_PASSWORD=CHANGE_ME_LOCAL
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=imeal-bucket

# Reverse Proxy (Caddy) Settings
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443

# API authentication and email OTP delivery.
# Production is OTP-only; REQUIRE_AUTH=false is a test-harness flag and is
# rejected unless NODE_ENV=test. Replace every placeholder secret out of band.
NODE_ENV=development
AUTH_MODE=otp
REQUIRE_AUTH=true
DATABASE_URL=postgresql://CHANGE_ME_LOCAL:CHANGE_ME_LOCAL@localhost:6432/imeal?schema=public&pgbouncer=true
QR_SIGNING_SECRET=replace-with-at-least-32-random-characters
OTP_HASH_SECRET=replace-with-at-least-32-random-characters
OTP_DELIVERY_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
OTP_PROVIDER_URL=https://provider.example.test/send
OTP_PROVIDER_API_KEY=replace-with-provider-api-key
OTP_PROVIDER_FROM=imeal@example.test
OTP_EXPIRY_SECONDS=600
OTP_RESEND_SECONDS=60
OTP_ATTEMPT_LIMIT=5
OTP_RATE_WINDOW_SECONDS=3600
OTP_ADDRESS_RATE_LIMIT=5
OTP_CLIENT_RATE_LIMIT=20

# Runtime lifecycle and migration evidence. Production values are injected out of band.
# SHUTDOWN_TIMEOUT_SECONDS bounds graceful drain time to 1-300 seconds.
RELEASE_VERSION=local
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_SECONDS=30
MIGRATION_EVIDENCE_PATH=/run/imeal/migration-gate.json
MIGRATION_TARGET_IDENTITY=local
# MIGRATION_DATABASE_URL=postgresql://CHANGE_ME_LOCAL:CHANGE_ME_LOCAL@postgres/imeal
# MIGRATION_DATABASE_URL is migration-gate-only; never pass it to API or worker.
# Production Compose boundary (inject these values from the deployment secret
# store; this template intentionally contains no production defaults).
# MIGRATION_TARGET_SCHEMA=
# PUBLIC_HOSTNAME=
# ACME_EMAIL=
# MIGRATION_GATE_IMAGE=
# MIGRATION_APPROVAL_ID=
# STOP_GRACE_PERIOD=45s  # must exceed SHUTDOWN_TIMEOUT_SECONDS plus drain margin
# PGBOUNCER_MAX_CLIENT_CONN=
# PGBOUNCER_DEFAULT_POOL_SIZE=
# DB_VOLUME_NAME=
# MINIO_VOLUME_NAME=
# MIGRATION_EVIDENCE_VOLUME_NAME=
# CADDY_DATA_VOLUME_NAME=
# CADDY_CONFIG_VOLUME_NAME=
# EDGE_NETWORK_NAME=
# APP_NETWORK_NAME=
# DATA_NETWORK_NAME=

# Each *_IMAGE value above must be an immutable repository@sha256:digest ref.



# Opaque PostgreSQL-backed session policy
SESSION_HASH_SECRET=replace-with-at-least-32-random-characters
SESSION_IDLE_TIMEOUT_SECONDS=1800
SESSION_ABSOLUTE_TIMEOUT_SECONDS=604800

# OTP delivery worker policy (the worker validates all values in production)
OTP_DELIVERY_BATCH_SIZE=100
OTP_DELIVERY_MAX_ATTEMPTS=4
OTP_DELIVERY_RETRY_BASE_SECONDS=60
OTP_DELIVERY_RETRY_MAX_SECONDS=900
OTP_DELIVERY_CLAIM_TIMEOUT_SECONDS=300

# Presenter GPS policy defaults. Real locations and coordinates are imported
# through the authorized roster/location operation; no location seed belongs here.
GPS_DEFAULT_GEOFENCE_RADIUS_METERS=150
GPS_DEFAULT_MAX_FIX_AGE_SECONDS=30
GPS_DEFAULT_MAX_ACCURACY_METERS=100

# Serving/QR invariants. These values are fixed by the approved contract.
SERVING_TIME_ZONE=Asia/Ho_Chi_Minh
SERVING_WINDOW_START=10:30
SERVING_WINDOW_END=13:30
NO_SHOW_PROCESSING_TIME=13:45
QR_TTL_SECONDS=5
QR_CLOCK_SKEW_SECONDS=2
PICKUP_SESSION_TTL_SECONDS=30

# Mobile and Admin Web API configuration
# EXPO_PUBLIC_API_URL is an explicit public API origin ending in /api, such as https://<api-id>.ngrok-free.app/api. Leave it empty for local/LAN discovery.
# EXPO_PACKAGER_PROXY_URL is a public origin that proxies Metro port 8081, without an /api suffix. Set both values only for remote-device sessions.
EXPO_PUBLIC_API_URL=
EXPO_PACKAGER_PROXY_URL=
VITE_API_URL=http://localhost:3000
EXPO_PUBLIC_EAS_PROJECT_ID=
