# PostgreSQL Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=imeal
POSTGRES_PORT=5432

# PgBouncer Settings
PGBOUNCER_PORT=6432

# MinIO Settings
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password123
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=imeal-bucket

# Reverse Proxy (Caddy) Settings
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443

# API security
REQUIRE_AUTH=true
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user
QR_SIGNING_SECRET=replace-with-at-least-32-random-characters

# Mobile and Admin Web public Entra configuration
EXPO_PUBLIC_API_URL=http://localhost:3000/api
EXPO_PUBLIC_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
EXPO_PUBLIC_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
EXPO_PUBLIC_ENTRA_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user
VITE_API_URL=http://localhost:3000
VITE_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_ENTRA_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user