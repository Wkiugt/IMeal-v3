# PostgreSQL Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=imeal
POSTGRES_PORT=5432

# PgBouncer Settings
PGBOUNCER_PORT=6432

# MinIO Settings
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password123
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=imeal-bucket

# Reverse Proxy (Caddy) Settings
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443

# API security
AUTH_MODE=local
REQUIRE_AUTH=true
DATABASE_URL=postgresql://postgres:postgres@localhost:6432/imeal?schema=public&pgbouncer=true
QR_SIGNING_SECRET=replace-with-at-least-32-random-characters
LOCAL_AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
LOCAL_AUTH_USERS='[{"username":"staff01","password":"replace-me","email":"staff01@imeal.local","name":"Staff 01","role":"staff"},{"username":"staff02","password":"replace-me","email":"staff02@imeal.local","name":"Staff 02","role":"staff"},{"username":"staff03","password":"replace-me","email":"staff03@imeal.local","name":"Staff 03","role":"staff"},{"username":"staff04","password":"replace-me","email":"staff04@imeal.local","name":"Staff 04","role":"staff"},{"username":"staff05","password":"replace-me","email":"staff05@imeal.local","name":"Staff 05","role":"staff"},{"username":"kitchen01","password":"replace-me","email":"kitchen01@imeal.local","name":"Kitchen 01","role":"kitchen"},{"username":"kitchen02","password":"replace-me","email":"kitchen02@imeal.local","name":"Kitchen 02","role":"kitchen"},{"username":"admin01","password":"replace-me","email":"admin01@imeal.local","name":"Admin 01","role":"admin"}]'

# Legacy Microsoft Entra configuration; only required with AUTH_MODE=entra
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user

# Mobile and Admin Web API configuration
EXPO_PUBLIC_API_URL=http://localhost:3000/api
VITE_API_URL=http://localhost:3000